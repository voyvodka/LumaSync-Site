---
import palmyeLogo from '../assets/brand/palmye-logo-dark.svg';

const href = 'https://palmye.com/s/lumasync';
---

<div class="maker-note" data-maker-note-bar data-pagefind-ignore>
  <a class="maker-note-link" href={href} rel="nofollow noopener">
    <span class="lead lead-long">Traveling soon? LumaSync's maker also builds</span>
    <span class="lead lead-short">Traveling?</span>
    <img class="logo" src={palmyeLogo.src} width="68" height="18" alt="Palmye" decoding="async" />
    <span class="tail tail-long">travel eSIMs for 200+ destinations</span>
    <span class="tail tail-short">eSIM, by LumaSync's maker</span>
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </a>
</div>

<style>
  .maker-note {
    --logo-h: 18px;
    --logo-mt: 1px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.5rem;
    background: var(--surface-1);
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-sm);
    line-height: 1.25;
  }

  .maker-note-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 0.25rem;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .maker-note-link:hover {
    color: var(--text-primary);
  }

  .maker-note-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .logo {
    display: block;
    flex: none;
    width: auto;
    height: var(--logo-h);
    margin-top: var(--logo-mt);
  }

  .lead-short,
  .tail-short {
    display: none;
  }

  @media (max-width: 860px) {
    .maker-note {
      --logo-h: 16px;
      --logo-mt: 2px;
      font-size: var(--fs-xs);
    }

    .maker-note-link {
      gap: 0.375rem;
      min-height: 36px;
      padding-inline: 0;
    }

    .lead-long,
    .tail-long {
      display: none;
    }

    .lead-short,
    .tail-short {
      display: inline;
    }
  }

  @media (max-width: 379px) {
    .lead-short {
      display: none;
    }
  }
</style>
