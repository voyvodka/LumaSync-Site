# Cloudflare Pages Headers file — long-lived immutable caching for
# fingerprinted build output.
#
# Every asset under /_astro/ has a content hash in its filename (e.g.
# BaseLayout.CHhRdPdo.css, ibm-plex-sans-latin-400-normal.CDDApCn2.woff2).
# A byte change bumps the hash, which bumps the URL — so the browser
# can safely cache the current URL forever and never revalidate.
#
# Without this, Cloudflare Pages defaults to `max-age=14400,
# must-revalidate`, forcing a conditional round-trip per asset on every
# reload. For self-hosted webfonts that round-trip is visible as a
# brief font-swap flicker (FOUT) on page reload.
#
# Same treatment for the Satori-generated OG images under /og/, which
# are build-time-immutable per page slug.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable

# Marketing screenshots / hero imagery. Filenames are not fingerprinted,
# so not `immutable`, but they only change on redeploy — a 30-day max-age
# drops the Cloudflare-default 4h must-revalidate round-trip on the LCP
# hero and the feature shots without risking long-term staleness.
/media/*
  Cache-Control: public, max-age=2592000

# RFC 8288 Link headers for agent discovery — points crawlers and AI
# agents at the canonical site map and the markdown entry point. The
# llms.txt files are markdown despite the .txt extension, so they are
# advertised as rel="alternate"; type="text/markdown" (the relation
# header-only agents key off for markdown discovery). Cloudflare Pages
# layers these onto the more-specific blocks above (which only override
# Cache-Control), so /_astro/, /og/, and /media/ responses carry them too.
/*
  Link: </llms.txt>; rel="alternate"; type="text/markdown"
  Link: </llms-full.txt>; rel="alternate"; type="text/markdown"
  Link: </sitemap-index.xml>; rel="sitemap"
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Static site calls no powerful browser APIs — deny the sensor / capture /
  # payment / Topics surfaces so an injected or embedded context can't reach
  # them. fullscreen/autoplay are left at the browser default (self-allowed).
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()
  # upgrade-insecure-requests (below) supersedes the now-deprecated
  # block-all-mixed-content directive, which has been removed.
  #
  # script-src keeps 'wasm-unsafe-eval' — REQUIRED by Pagefind (the Cmd+K
  # search), which compiles a WebAssembly module in its web worker. Without
  # it the browser throws "Refused to create a WebAssembly object because
  # 'wasm-unsafe-eval' is not an allowed source" and search silently breaks.
  # 'wasm-unsafe-eval' only permits WASM compilation (not general eval), so
  # it is the narrow, safe directive — do NOT drop it in a CSP-hardening pass.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;
